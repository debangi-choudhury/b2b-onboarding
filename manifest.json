{
  "vendor": "logixalpartnerus",
  "name": "b2b-onboarding",
  "version": "0.1.4",
  "title": "B2B Onboarding",
  "description": "Business applications with document upload, verification and staged approval for B2B Organizations",
  "builders": {
    "node": "7.x",
    "graphql": "2.x",
    "react": "3.x",
    "store": "0.x",
    "messages": "1.x",
    "admin": "0.x",
    "docs": "0.x"
  },
  "dependencies": {
    "vtex.b2b-organizations-graphql": "2.x",
    "vtex.store": "2.x",
    "vtex.css-handles": "0.x",
    "vtex.render-runtime": "8.x",
    "vtex.styleguide": "9.x"
  },
  "policies": [
    {
      "name": "vtex.b2b-organizations-graphql:resolve-graphql"
    },
    {
      "name": "ADMIN_DS"
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "{{account}}.vtexcommercestable.com.br",
        "path": "/api/dataentities/*"
      }
    }
  ],
  "settingsSchema": {
    "title": "B2B Onboarding",
    "type": "object",
    "properties": {
      "stages": {
        "title": "Approval stages",
        "description": "Stages each new application goes through, in order. Leave empty for the default: Document review, Compliance check, Final approval. The last stage must be of type APPROVAL, and at most one stage can be VERIFICATION. Applications already submitted keep their stages.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "title": "Label",
              "type": "string"
            },
            "id": {
              "title": "ID (optional)",
              "description": "Lowercase letters, digits and hyphens. Made from the label when empty.",
              "type": "string"
            },
            "type": {
              "title": "Type",
              "type": "string",
              "enum": [
                "REVIEW",
                "VERIFICATION",
                "APPROVAL"
              ],
              "default": "REVIEW"
            }
          }
        }
      }
    }
  },
  "$schema": "https://raw.githubusercontent.com/vtex/node-vtex-api/master/gen/manifest.schema"
}
