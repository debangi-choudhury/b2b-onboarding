{
  "memory": 256,
  "ttl": 10,
  "timeout": 30,
  "minReplicas": 2,
  "maxReplicas": 4,
  "workers": 1,
  "rateLimitPerReplica": {
    "perMinute": 300,
    "concurrent": 10
  },
  "routes": {
    "apply": {
      "path": "/_v/b2b-onboarding/apply",
      "public": true
    },
    "status": {
      "path": "/_v/b2b-onboarding/status",
      "public": true
    }
  }
}
