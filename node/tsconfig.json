{
  "extends": "@vtex/tsconfig",
  "compilerOptions": {
    "noEmitOnError": false,
    "lib": ["es2019"],
    "module": "commonjs",
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"],
  "typeAcquisition": {
    "enable": false
  }
}
